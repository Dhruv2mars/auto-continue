{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/cursor/hooks/auto-continue.mjs\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/cursor/hooks/auto-continue.mjs\"",
        "failClosed": true
      }
    ]
  }
}
